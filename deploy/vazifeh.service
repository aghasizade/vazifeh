# /etc/systemd/system/vazifeh.service
[Unit]
Description=Vazifeh server
After=network.target

[Service]
Type=simple
User=vazifeh
WorkingDirectory=/opt/vazifeh
Environment=NODE_ENV=production
Environment=TZ=Asia/Tehran
Environment=HOST=127.0.0.1
Environment=PORT=8090
Environment=TASKS_DATA=/var/lib/vazifeh
ExecStart=/usr/bin/node server/standalone.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
