{
  "name": "vazifeh",
  "description": "سامانه متن‌باز مدیریت وظایف و گزارش کار تیمی، فارسی و راست‌به‌چپ",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.13" },
  "version": "1.0.10",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server/standalone.js",
    "build": "vite build",
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "build": {
    "appId": "app.vazifeh",
    "productName": "Vazifeh",
    "directories": {
      "output": "build-output"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سامانه وظیفه",
      "uninstallDisplayName": "سامانه وظیفه",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Vazifeh-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "jalaali-js": "2.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "echarts": "6.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "vazirmatn": "33.0.3",
    "vite": "8.3.4"
  }
}
